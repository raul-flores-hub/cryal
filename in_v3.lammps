# Relaxation protocol of the BACH search reported in the accompanying article:
# a staged NPT anneal on a triclinic cell (20 K at 3000 bar, then 20 -> 10 K and
# 10 K at 1 bar; 0.4 fs timestep, 12000 steps in all), then a conjugate-gradient
# minimization in which the cell is also relaxed isotropically at 1 bar
# (box/relax is not a separate step: it adds the cell to the minimizer).
# CrYAL writes structure.data and reads energy.dat and minimized.data.
units           metal
boundary        p p p
atom_style      atomic
newton on

read_data       structure.data

# One mass per atom type, in the order given by specOrder in INPUT.txt.
# This example is set up for benzene (C, H); add the types your molecule needs.
mass 1 12.011
mass 2 1.008

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 20000 page 200000

# Point this at your MACE-OFF model exported for ML-IAP.
pair_style      mliap unified /home/ibeth/RAUL/uspexrunz/MACE-OFF23_small.model-mliap_lammps.pt 0
pair_coeff      * * C H          # must match specOrder in INPUT.txt

thermo          50
thermo_style    custom step temp pe etotal press vol density lx ly lz

timestep        0.0004

fix 1 all npt temp 20.0 20.0 0.04 tri 3000.0 3000.0 0.4
run 6000

unfix 1
fix 2 all npt temp 20.0 10.0 0.04 tri 1.0 1.0 0.4
run 4000

unfix 2
fix 3 all npt temp 10.0 10.0 0.04 tri 1.0 1.0 0.4
run 2000

unfix 3
fix 4 all box/relax iso 1.0
minimize        1.0e-12 1.0e-10 10000 200000

variable        myEnergy equal pe
print           "${myEnergy}" file energy.dat

write_data      minimized.data
